73.	Create a shopping cart system where users can:
<!DOCTYPE html>
<html>
<body>

<input id="product" placeholder="Product name">
<input id="price" placeholder="Price">
<button onclick="addProduct()">Add</button>

<br><br>

<ul id="list"></ul>

<h3>Total: <span id="total">0</span></h3>

<script>

let cart = [];

function addProduct(){

    if(product.value.trim() == "" || price.value.trim() == "") return;

    cart.push({
        name: product.value,
        price: Number(price.value),
        qty: 1
    });

    product.value = "";
    price.value = "";

    show();
}

function changeQty(i){

    cart[i].qty = cart[i].qty + 1;

    show();
}

function decreaseQty(i){

    if(cart[i].qty > 1){
        cart[i].qty = cart[i].qty - 1;
    }

    show();
}

function deleteProduct(i){

    cart.splice(i,1);

    show();
}

function show(){

    let list = document.getElementById("list");
    let total = document.getElementById("total");

    list.innerHTML = "";

    let sum = 0;

    for(let i=0;i<cart.length;i++){

        sum = sum + (cart[i].price * cart[i].qty);

        list.innerHTML += `
        <li>
            ${cart[i].name} - ${cart[i].price} x ${cart[i].qty}
            <button onclick="changeQty(${i})">+</button>
            <button onclick="decreaseQty(${i})">-</button>
            <button onclick="deleteProduct(${i})">Delete</button>
        </li>
        `;
    }

    total.innerText = sum;
}

</script>

</body>
</html>

74.	Create a weather dashboard that:
<!DOCTYPE html>
<html>
<body>

<input id="city" placeholder="City">
<button onclick="getWeather()">Get Weather</button>

<h2 id="info"></h2>

<script>

async function getWeather(){

    let city = document.getElementById("city").value;

    if(city.trim() == "") return;

    let geoUrl = "https://geocoding-api.open-meteo.com/v1/search?name=" + city;

    let geoRes = await fetch(geoUrl);
    let geoData = await geoRes.json();

    if(!geoData.results){
        document.getElementById("info").innerText = "City not found";
        return;
    }

    let lat = geoData.results[0].latitude;
    let lon = geoData.results[0].longitude;

    let weatherUrl = "https://api.open-meteo.com/v1/forecast?latitude=" + lat + "&longitude=" + lon + "&current_weather=true";

    let res = await fetch(weatherUrl);
    let data = await res.json();

    let weather = data.current_weather;

    document.getElementById("info").innerText =
        city + " Temp: " + weather.temperature + "°C";

    if(weather.temperature < 10){
        document.body.style.background = "lightblue";
    }
    else if(weather.temperature < 25){
        document.body.style.background = "lightyellow";
    }
    else{
        document.body.style.background = "orange";
    }
}

</script>

</body>
</html>


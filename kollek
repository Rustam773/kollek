    tasks[i].completed = true;

    show();
}

function del(i){

    tasks.splice(i,1);

    show();
}

function show(){

    list.innerHTML = "";

    for(let i=0;i<tasks.length;i++){

        if(filter.value=="completed" && tasks[i].completed==false)
            continue;

        if(filter.value=="pending" && tasks[i].completed==true)
            continue;


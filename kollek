<input id="search" placeholder="Movie name">
<button onclick="getMovies()">Search</button>

<div id="list"></div>

<script>

let movies = [
    {
        title: "Batman",
        year: 2022,
        poster: "https://via.placeholder.com/100x150?text=Batman"
    },
    {
        title: "Superman",
        year: 2021,
        poster: "https://via.placeholder.com/100x150?text=Superman"
    },
    {
        title: "Spiderman",
        year: 2023,
        poster: "https://via.placeholder.com/100x150?text=Spiderman"
    }
];

function getMovies(){

    let name = document.getElementById("search").value.toLowerCase();
    let list = document.getElementById("list");

    list.innerHTML = "";

    let found = false;

    for(let i=0;i<movies.length;i++){

        if(movies[i].title.toLowerCase().includes(name)){

            list.innerHTML += `

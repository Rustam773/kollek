11.Check Perfect Binary:
public static boolean isPerfect(TreeNode r) {
    int d = depth(r);
    return check(r, d, 0);
}

static int depth(TreeNode r) {
    return r == null ? 0 : 1 + depth(r.left);
}

static boolean check(TreeNode r, int d, int l) {
    if (r == null) return true;
    if (r.left == null && r.right == null) return d == l + 1;
    if (r.left == null || r.right == null) return false;
    return check(r.left, d, l + 1) && check(r.right, d, l + 1);
}
12.Balanced BST:
public static TreeNode sortedArrayToBST(int[] a) {
    return f(a, 0, a.length - 1);
}

static TreeNode f(int[] a, int l, int r) {
    if (l > r) return null;
    int m = (l + r) / 2;
    TreeNode n = new TreeNode(a[m]);
    n.left = f(a, l, m - 1);
    n.right = f(a, m + 1, r);
    return n;
}

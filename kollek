        int[] result = new int[n];
        boolean[] used = new boolean[n + 1];
        java.util.Random r = new java.util.Random();

        for (int i = 0; i < n; i++) {
            int x = r.nextInt(n) + 1;

            while (used[x]) {
                x = r.nextInt(n) + 1;
            }


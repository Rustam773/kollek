<input id="projectName" placeholder="Project name">
<button onclick="addProject()">Add Project</button>

<hr>

<div id="projects"></div>

<script>

let projects = [];

function addProject() {
  let name = document.getElementById("projectName").value;
  if (name.trim() === "") return;

  projects.push({
    name: name,
    tasks: []
  });

  document.getElementById("projectName").value = "";
  render();
}

function addTask(index) {
  let task = prompt("Enter task:");

  if (!task || task.trim() === "") return;

  projects[index].tasks.push({
    name: task,
    done: false
  });

  render();
}

function toggleTask(pIndex, tIndex) {
  projects[pIndex].tasks[tIndex].done =
    !projects[pIndex].tasks[tIndex].done;

  render();
}

function progress(project) {
  if (project.tasks.length === 0) return 0;

  let done = 0;

  project.tasks.forEach(t => {
    if (t.done) done++;
  });

  return Math.round((done / project.tasks.length) * 100);
}

function render() {
  let box = document.getElementById("projects");
  box.innerHTML = "";

  projects.forEach((p, i) => {
    box.innerHTML += `
      <div style="border:1px solid black; padding:10px; margin:10px;">
        <h3>${p.name}</h3>

        <p>Progress: ${progress(p)}%</p>

        <button onclick="addTask(${i})">➕ Add Task</button>

        <ul>
          ${p.tasks.map((t, j) => `
            <li onclick="toggleTask(${i},${j})"
                style="cursor:pointer; ${t.done ? 'text-decoration:line-through' : ''}">
              ${t.name}
            </li>
          `).join("")}
        </ul>
      </div>
    `;
  });
}

</script>

